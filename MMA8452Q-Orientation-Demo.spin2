{
----------------------------------------------------------------------------------------------------
    Filename:       MMA8452Q-Orientation-Demo.spin2
    Description:    Demo of the MMA8452Q driver
        * portrait/landscape orientation detection functionality
    Author:         Jesse Burt
    Started:        Nov 9, 2021
    Updated:        Jul 4, 2024
    Copyright (c) 2024 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = cfg._clkfreq_def
    _xtlfreq    = cfg._xtlfreq


OBJ

    cfg:    "boardcfg.p2eval"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    sensor: "sensor.accel.3dof.mma8452q" | SCL=0, SDA=1, I2C_FREQ=400_000, I2C_ADDR=0


PUB main()

    setup()
    sensor.preset_active()                       ' default settings, but enable
                                                ' sensor power, and set
                                                ' scale factors
    sensor.orient_detect_ena(true)               ' enable orientation detection

    repeat
        ser.pos_xy(0, 3)
        ser.puts(@"Orientation: ")
        case sensor.orientation()
            sensor.PORTUP_FR:
                ser.str(@"Portrait-up, front-facing")
            sensor.PORTUP_BK:
                ser.str(@"Portrait-up, back-facing")
            sensor.PORTDN_FR:
                ser.str(@"Portrait-down, front-facing")
            sensor.PORTDN_BK:
                ser.str(@"Portrait-down, back-facing")
            sensor.LANDRT_FR:
                ser.str(@"Landscape-right, front-facing")
            sensor.LANDRT_BK:
                ser.str(@"Landscape-right, back-facing")
            sensor.LANDLT_FR:
                ser.str(@"Landscape-left, front-facing")
            sensor.LANDLT_BK:
                ser.str(@"Landscape-left, back-facing")
            other:
        ser.clear_line()

        if ( ser.getchar_noblock() == "c" )     ' press the 'c' key in the demo
            calibrate()                         ' to calibrate sensor offsets


PUB calibrate()

    ser.pos_xy(0, 5)
    ser.puts(@"Calibrating...")
    sensor.calibrate_accel()
    ser.pos_x(0)
    ser.clear_line()


PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"MMA8452Q driver started (I2C)")
    else
        ser.strln(@"MMA8452Q driver failed to start - halting")
        repeat

DAT
